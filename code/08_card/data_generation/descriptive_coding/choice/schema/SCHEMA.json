  "evidence_contract": {
    "required": [
      "source_field",
      "source_json_pointer",
      "span_start",
      "span_end",
      "text",
      "text_sha256"
    ],
    "coordinates": "Python Unicode string offsets; end exclusive; text must equal unmodified declaration[field][start:end]",
    "source_integrity": "source public-batch SHA256 plus declaration SHA256 plus context_version",
    "allowed_source_roles": [
      "frozen_declaration",
      "hash_bound_codebook",
      "hash_bound_design",
      "corroborative_code_or_report"
    ],
    "missing": "null and explicit reason; never invent evidence"
  },
  "signature_contract": {
    "normalization": "canonical JSON only; no keyword-only or lossy semantic normalization",
    "content": [
      "dimension",
      "complete relevant declaration spans",
      "relevant context spans",
      "cross-field requirements",
      "source-role and conflict flags"
    ],
    "case_identity": "source hashes and IDs retained separately",
    "reuse": "only a reviewed exact signature decision; coherence check still required"
  },
  "pilot": {
    "n": 48,
    "selection": "smallest SHA256(UTF8(card-trace-schema-pilot-v1)+NUL+UTF8(raw_case_id)); tie raw_case_id",
    "without_replacement": true,
    "no_replacement_for_unavailable": true,
    "selection_blind_to": [
      "content",
      "stratum",
      "numeric_results",
      "match_verdict"
    ],
    "manual_review_scope": [
      "outcome",
      "sample_restrictions",
      "model"
    ],
    "no_prevalence_claim": true
  },
  "critical_rules": [
    "Never infer undeclared probability assumptions from code, estimator or SE.",
    "Never change or infer accepted match verdict.",
    "Preserve transformations, interactions, weights, mixed eligibility, all required variables and support conditions.",
    "Full-time count differs from FTE and FT+PT headcount.",
    "Manager-inclusive headcount is employee_headcount with manager_inclusion=included.",
    "Closure bins retain exact status set and raw followup-count requirements; state-specific eligibility is residual.",
    "Recorded closure zeros without an explicit recoding operator remain complete cases when no status filter is imposed.",
    "Two unrestricted state mean changes with no controls qualify nj_only.",
    "Panels do not automatically qualify as change-score models; preserve form.",
    "Explicit positive interaction terms outrank additive/no-interaction wording elsewhere; unresolved contradiction is residual.",
    "Ancillary inference lives separately; ambiguous restriction role remains ambiguous."
  ],
  "authoritative_rules_file": "SCHEMA.md"
}
